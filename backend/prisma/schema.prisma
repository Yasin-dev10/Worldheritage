generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EditorialState {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED

  @@map("editorial_state")
}

enum SourceKind {
  PRIMARY
  SCHOLARLY_SECONDARY
  REFERENCE
  ORAL_HISTORY
  ARCHIVAL_RECORD
  OTHER

  @@map("source_kind")
}

enum ClaimStanding {
  WELL_SUPPORTED
  SCHOLARLY_INTERPRETATION
  DISPUTED
  UNCERTAIN

  @@map("claim_standing")
}

enum HistoricalDatePrecision {
  EXACT_DAY
  MONTH
  YEAR
  DECADE
  CENTURY
  RANGE
  CIRCA
  UNKNOWN
}

enum HistoricalDateCertainty {
  CERTAIN
  PROBABLE
  POSSIBLE
  DISPUTED
  UNKNOWN
}

model Country {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String                @unique
  isoAlpha2         String?               @unique(map: "countries_iso_code_unique") @map("iso_3166_1_alpha2") @db.Char(2)
  region            String?
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  revisions         CountryRevision[]
  eventLinks        EventCountry[]
  civilizationLinks CivilizationCountry[]
  personLinks       PersonCountry[]
  articleLinks      ArticleCountry[]

  @@index([region, slug])
  @@map("countries")
}

model CountryRevision {
  id             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId      String                       @map("country_id") @db.Uuid
  revisionNumber Int                          @map("revision_number")
  state          EditorialState               @default(DRAFT)
  authorSubject  String                       @map("author_subject")
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt    DateTime?                    @map("submitted_at") @db.Timestamptz(6)
  publishedAt    DateTime?                    @map("published_at") @db.Timestamptz(6)
  country        Country                      @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  translations   CountryRevisionTranslation[]
  sources        CountryRevisionSource[]
  reviews        EditorialReview[]

  @@unique([countryId, revisionNumber])
  @@index([state, createdAt], map: "country_revisions_state_idx")
  @@map("country_revisions")
}

model CountryRevisionTranslation {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId          String          @map("revision_id") @db.Uuid
  locale              String
  title               String
  summary             String
  body                String
  translationOfLocale String?         @map("translation_of_locale")
  translatorSubject   String?         @map("translator_subject")
  revision            CountryRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([revisionId, locale])
  @@map("country_revision_translations")
}

model Source {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceKind            SourceKind              @map("source_kind")
  creator               String?
  title                 String
  publisherOrCollection String?                 @map("publisher_or_collection")
  publicationDateText   String?                 @map("publication_date_text")
  stableIdentifier      String?                 @map("stable_identifier")
  url                   String?
  accessedAt            DateTime?               @map("accessed_at") @db.Timestamptz(6)
  rightsStatus          String                  @default("UNKNOWN") @map("rights_status")
  rightsNotes           String?                 @map("rights_notes")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  countryRevisions      CountryRevisionSource[]
  eventLinks            EventSource[]
  personLinks           PersonSource[]
  civilizationLinks     CivilizationSource[]
  articleLinks          ArticleSource[]
  periodLinks           PeriodSource[]
  museumItemLinks       MuseumItemSource[]
  historicalMapLinks    HistoricalMapSource[]

  @@index([stableIdentifier], map: "sources_stable_identifier_idx")
  @@map("sources")
}

model CountryRevisionSource {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId    String          @map("revision_id") @db.Uuid
  sourceId      String          @map("source_id") @db.Uuid
  locale        String?
  locator       String?
  claimNote     String          @map("claim_note")
  claimStanding ClaimStanding   @map("claim_standing")
  revision      CountryRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  source        Source          @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([sourceId], map: "country_revision_sources_source_idx")
  @@map("country_revision_sources")
}

model EditorialReview {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId      String          @map("revision_id") @db.Uuid
  reviewerSubject String          @map("reviewer_subject")
  outcome         String
  rationale       String
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  revision        CountryRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([revisionId, createdAt], map: "editorial_reviews_revision_idx")
  @@map("editorial_reviews")
}

model AuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorSubject String?  @map("actor_subject")
  action       String
  targetType   String   @map("target_type")
  targetId     String?  @map("target_id") @db.Uuid
  requestId    String?  @map("request_id")
  metadata     Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId, createdAt], map: "audit_events_target_idx")
  @@map("audit_events")
}

model ContentRevision {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentType    String         @map("content_type")
  contentId      String         @map("content_id") @db.Uuid
  revisionNumber Int            @map("revision_number")
  state          EditorialState
  editorSubject  String         @map("editor_subject")
  snapshot       Json           @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  reviews        CmsReview[]

  @@unique([contentType, contentId, revisionNumber])
  @@index([contentType, contentId, createdAt])
  @@index([state, createdAt])
  @@map("content_revisions")
}

model CmsReview {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId      String          @map("revision_id") @db.Uuid
  reviewerSubject String          @map("reviewer_subject")
  outcome         String
  rationale       String
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  revision        ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@index([revisionId, createdAt])
  @@map("cms_reviews")
}

model MediaAsset {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageLocation String          @map("storage_location")
  mediaType       String          @map("media_type")
  altText         String?         @map("alt_text")
  attribution     String?
  provenance      String?
  license         String?
  rightsNotes     String?         @map("rights_notes")
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  museumItems     MuseumItem[]
  historicalMaps  HistoricalMap[]

  @@index([createdAt])
  @@map("media_assets")
}

model MuseumItem {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String                  @unique
  dateDisplay        String?                 @map("date_display")
  datePrecision      HistoricalDatePrecision @default(UNKNOWN) @map("date_precision")
  provenance         String?
  currentLocation    String?                 @map("current_location")
  creatorAttribution String?                 @map("creator_attribution")
  rightsNotes        String?                 @map("rights_notes")
  state              EditorialState          @default(DRAFT)
  publishedAt        DateTime?               @map("published_at") @db.Timestamptz(6)
  mediaAssetId       String?                 @map("media_asset_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  mediaAsset         MediaAsset?             @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  translations       MuseumItemTranslation[]
  sources            MuseumItemSource[]
  exhibitions        ExhibitionItem[]

  @@index([state, slug])
  @@map("museum_items")
}

model MuseumItemTranslation {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId      String     @map("item_id") @db.Uuid
  locale      String
  title       String
  description String
  item        MuseumItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([itemId, locale])
  @@map("museum_item_translations")
}

model MuseumItemSource {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId        String        @map("item_id") @db.Uuid
  sourceId      String        @map("source_id") @db.Uuid
  locator       String?
  claimNote     String        @map("claim_note")
  claimStanding ClaimStanding @map("claim_standing")
  item          MuseumItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  source        Source        @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([itemId, sourceId])
  @@map("museum_item_sources")
}

model MuseumExhibition {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String                  @unique
  topic        String?
  state        EditorialState          @default(DRAFT)
  publishedAt  DateTime?               @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  translations ExhibitionTranslation[]
  items        ExhibitionItem[]

  @@index([state, slug])
  @@map("museum_exhibitions")
}

model ExhibitionTranslation {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exhibitionId String           @map("exhibition_id") @db.Uuid
  locale       String
  title        String
  summary      String
  exhibition   MuseumExhibition @relation(fields: [exhibitionId], references: [id], onDelete: Restrict)

  @@unique([exhibitionId, locale])
  @@map("exhibition_translations")
}

model ExhibitionItem {
  exhibitionId String           @map("exhibition_id") @db.Uuid
  itemId       String           @map("item_id") @db.Uuid
  position     Int
  exhibition   MuseumExhibition @relation(fields: [exhibitionId], references: [id], onDelete: Restrict)
  item         MuseumItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([exhibitionId, itemId])
  @@unique([exhibitionId, position])
  @@map("exhibition_items")
}

model HistoricalMap {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String                     @unique
  dateDisplay    String?                    @map("date_display")
  startYear      Int?                       @map("start_year")
  endYear        Int?                       @map("end_year")
  datePrecision  HistoricalDatePrecision    @default(UNKNOWN) @map("date_precision")
  geographicArea String?                    @map("geographic_area")
  provenance     String?
  rightsNotes    String?                    @map("rights_notes")
  state          EditorialState             @default(DRAFT)
  publishedAt    DateTime?                  @map("published_at") @db.Timestamptz(6)
  mediaAssetId   String?                    @map("media_asset_id") @db.Uuid
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  mediaAsset     MediaAsset?                @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  translations   HistoricalMapTranslation[]
  sources        HistoricalMapSource[]

  @@index([state, startYear, slug])
  @@map("historical_maps")
}

model HistoricalMapTranslation {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mapId       String        @map("map_id") @db.Uuid
  locale      String
  title       String
  description String
  map         HistoricalMap @relation(fields: [mapId], references: [id], onDelete: Restrict)

  @@unique([mapId, locale])
  @@map("historical_map_translations")
}

model HistoricalMapSource {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mapId         String        @map("map_id") @db.Uuid
  sourceId      String        @map("source_id") @db.Uuid
  claimNote     String        @map("claim_note")
  claimStanding ClaimStanding @map("claim_standing")
  map           HistoricalMap @relation(fields: [mapId], references: [id], onDelete: Restrict)
  source        Source        @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([mapId, sourceId])
  @@map("historical_map_sources")
}

model HistoricalEvent {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String                  @unique
  category      String
  calendar      String?
  dateDisplay   String?
  startYear     Int?                    @map("start_year")
  endYear       Int?                    @map("end_year")
  datePrecision HistoricalDatePrecision @default(UNKNOWN) @map("date_precision")
  dateCertainty HistoricalDateCertainty @default(UNKNOWN) @map("date_certainty")
  state         EditorialState          @default(DRAFT)
  publishedAt   DateTime?               @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations  EventTranslation[]
  countries     EventCountry[]
  people        EventPerson[]
  sources       EventSource[]
  timelineLinks TimelineEvent[]
  civilizations CivilizationEvent[]
  periods       PeriodEvent[]
  articleLinks  ArticleEvent[]

  @@index([state, startYear, slug])
  @@index([category, state, startYear])
  @@map("historical_events")
}

model EventTranslation {
  id      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String          @map("event_id") @db.Uuid
  locale  String
  title   String
  summary String
  body    String
  event   HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, locale])
  @@map("event_translations")
}

model EventCountry {
  eventId   String          @map("event_id") @db.Uuid
  countryId String          @map("country_id") @db.Uuid
  relation  String          @default("RELATED")
  event     HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  country   Country         @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([eventId, countryId])
  @@map("event_countries")
}

model EventPerson {
  eventId  String           @map("event_id") @db.Uuid
  personId String           @map("person_id") @db.Uuid
  relation String           @default("RELATED")
  event    HistoricalEvent  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  person   HistoricalPerson @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([eventId, personId])
  @@map("event_people")
}

model EventSource {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String          @map("event_id") @db.Uuid
  sourceId      String          @map("source_id") @db.Uuid
  locator       String?
  claimNote     String          @map("claim_note")
  claimStanding ClaimStanding   @map("claim_standing")
  event         HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  source        Source          @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@map("event_sources")
}

model HistoricalPerson {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String               @unique
  birthDateText String?              @map("birth_date_text")
  birthYear     Int?                 @map("birth_year")
  deathDateText String?              @map("death_date_text")
  deathYear     Int?                 @map("death_year")
  state         EditorialState       @default(DRAFT)
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations  PersonTranslation[]
  events        EventPerson[]
  sources       PersonSource[]
  civilizations CivilizationPerson[]
  countries     PersonCountry[]
  articleLinks  ArticlePerson[]

  @@index([state, slug])
  @@map("historical_people")
}

model PersonTranslation {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId String           @map("person_id") @db.Uuid
  locale   String
  title    String
  summary  String
  body     String
  person   HistoricalPerson @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([personId, locale])
  @@map("person_translations")
}

model PersonSource {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId      String           @map("person_id") @db.Uuid
  sourceId      String           @map("source_id") @db.Uuid
  locator       String?
  claimNote     String           @map("claim_note")
  claimStanding ClaimStanding    @map("claim_standing")
  person        HistoricalPerson @relation(fields: [personId], references: [id], onDelete: Restrict)
  source        Source           @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([personId])
  @@map("person_sources")
}

model Civilization {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String                    @unique
  region        String?
  calendar      String?
  dateDisplay   String?                   @map("date_display")
  startYear     Int?                      @map("start_year")
  endYear       Int?                      @map("end_year")
  datePrecision HistoricalDatePrecision   @default(UNKNOWN) @map("date_precision")
  state         EditorialState            @default(DRAFT)
  publishedAt   DateTime?                 @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  translations  CivilizationTranslation[]
  countries     CivilizationCountry[]
  people        CivilizationPerson[]
  events        CivilizationEvent[]
  sources       CivilizationSource[]
  articleLinks  ArticleCivilization[]

  @@index([state, region, slug])
  @@map("civilizations")
}

model CivilizationTranslation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  civilizationId String       @map("civilization_id") @db.Uuid
  locale         String
  title          String
  summary        String
  body           String
  civilization   Civilization @relation(fields: [civilizationId], references: [id], onDelete: Restrict)

  @@unique([civilizationId, locale])
  @@map("civilization_translations")
}

model CivilizationCountry {
  civilizationId String       @map("civilization_id") @db.Uuid
  countryId      String       @map("country_id") @db.Uuid
  civilization   Civilization @relation(fields: [civilizationId], references: [id], onDelete: Restrict)
  country        Country      @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([civilizationId, countryId])
  @@map("civilization_countries")
}

model CivilizationPerson {
  civilizationId String           @map("civilization_id") @db.Uuid
  personId       String           @map("person_id") @db.Uuid
  relation       String           @default("RELATED")
  civilization   Civilization     @relation(fields: [civilizationId], references: [id], onDelete: Restrict)
  person         HistoricalPerson @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([civilizationId, personId])
  @@map("civilization_people")
}

model CivilizationEvent {
  civilizationId String          @map("civilization_id") @db.Uuid
  eventId        String          @map("event_id") @db.Uuid
  relation       String          @default("RELATED")
  civilization   Civilization    @relation(fields: [civilizationId], references: [id], onDelete: Restrict)
  event          HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([civilizationId, eventId])
  @@map("civilization_events")
}

model CivilizationSource {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  civilizationId String        @map("civilization_id") @db.Uuid
  sourceId       String        @map("source_id") @db.Uuid
  locator        String?
  claimNote      String        @map("claim_note")
  claimStanding  ClaimStanding @map("claim_standing")
  civilization   Civilization  @relation(fields: [civilizationId], references: [id], onDelete: Restrict)
  source         Source        @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([civilizationId])
  @@map("civilization_sources")
}

model HistoryArticle {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String                @unique
  authorName    String                @map("author_name")
  editorName    String?               @map("editor_name")
  publishedAt   DateTime?             @map("published_at") @db.Timestamptz(6)
  updatedAt     DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  state         EditorialState        @default(DRAFT)
  translations  ArticleTranslation[]
  sources       ArticleSource[]
  countries     ArticleCountry[]
  events        ArticleEvent[]
  people        ArticlePerson[]
  civilizations ArticleCivilization[]

  @@index([state, publishedAt, slug])
  @@map("history_articles")
}

model HistoricalPeriod {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String                  @unique
  dateDisplay   String?                 @map("date_display")
  startYear     Int?                    @map("start_year")
  endYear       Int?                    @map("end_year")
  datePrecision HistoricalDatePrecision @default(UNKNOWN) @map("date_precision")
  dateCertainty HistoricalDateCertainty @default(UNKNOWN) @map("date_certainty")
  state         EditorialState          @default(DRAFT)
  publishedAt   DateTime?               @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations  PeriodTranslation[]
  sources       PeriodSource[]
  events        PeriodEvent[]

  @@index([state, startYear, slug])
  @@map("historical_periods")
}

model PeriodTranslation {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId String           @map("period_id") @db.Uuid
  locale   String
  title    String
  summary  String
  body     String
  period   HistoricalPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([periodId, locale])
  @@map("period_translations")
}

model PeriodSource {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId      String           @map("period_id") @db.Uuid
  sourceId      String           @map("source_id") @db.Uuid
  locator       String?
  claimNote     String           @map("claim_note")
  claimStanding ClaimStanding    @map("claim_standing")
  period        HistoricalPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  source        Source           @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([periodId, sourceId])
  @@map("period_sources")
}

model PeriodEvent {
  periodId String           @map("period_id") @db.Uuid
  eventId  String           @map("event_id") @db.Uuid
  period   HistoricalPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  event    HistoricalEvent  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([periodId, eventId])
  @@map("period_events")
}

model PersonCountry {
  personId  String           @map("person_id") @db.Uuid
  countryId String           @map("country_id") @db.Uuid
  relation  String           @default("RELATED")
  person    HistoricalPerson @relation(fields: [personId], references: [id], onDelete: Restrict)
  country   Country          @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([personId, countryId])
  @@map("person_countries")
}

model ArticleCountry {
  articleId String         @map("article_id") @db.Uuid
  countryId String         @map("country_id") @db.Uuid
  article   HistoryArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)
  country   Country        @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@id([articleId, countryId])
  @@map("article_countries")
}

model ArticleEvent {
  articleId String          @map("article_id") @db.Uuid
  eventId   String          @map("event_id") @db.Uuid
  article   HistoryArticle  @relation(fields: [articleId], references: [id], onDelete: Restrict)
  event     HistoricalEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([articleId, eventId])
  @@map("article_events")
}

model ArticlePerson {
  articleId String           @map("article_id") @db.Uuid
  personId  String           @map("person_id") @db.Uuid
  article   HistoryArticle   @relation(fields: [articleId], references: [id], onDelete: Restrict)
  person    HistoricalPerson @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@id([articleId, personId])
  @@map("article_people")
}

model ArticleCivilization {
  articleId      String         @map("article_id") @db.Uuid
  civilizationId String         @map("civilization_id") @db.Uuid
  article        HistoryArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)
  civilization   Civilization   @relation(fields: [civilizationId], references: [id], onDelete: Restrict)

  @@id([articleId, civilizationId])
  @@map("article_civilizations")
}

model ArticleTranslation {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId String         @map("article_id") @db.Uuid
  locale    String
  title     String
  summary   String
  body      String
  article   HistoryArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@unique([articleId, locale])
  @@map("article_translations")
}

model ArticleSource {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId     String         @map("article_id") @db.Uuid
  sourceId      String         @map("source_id") @db.Uuid
  locator       String?
  claimNote     String         @map("claim_note")
  claimStanding ClaimStanding  @map("claim_standing")
  article       HistoryArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)
  source        Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([articleId])
  @@map("article_sources")
}

model HistoricalTimeline {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String                @unique
  state        EditorialState        @default(DRAFT)
  publishedAt  DateTime?             @map("published_at") @db.Timestamptz(6)
  translations TimelineTranslation[]
  events       TimelineEvent[]

  @@index([state, slug])
  @@map("historical_timelines")
}

model TimelineTranslation {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timelineId String             @map("timeline_id") @db.Uuid
  locale     String
  title      String
  summary    String
  timeline   HistoricalTimeline @relation(fields: [timelineId], references: [id], onDelete: Restrict)

  @@unique([timelineId, locale])
  @@map("timeline_translations")
}

model TimelineEvent {
  timelineId String             @map("timeline_id") @db.Uuid
  eventId    String             @map("event_id") @db.Uuid
  position   Int
  timeline   HistoricalTimeline @relation(fields: [timelineId], references: [id], onDelete: Restrict)
  event      HistoricalEvent    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([timelineId, eventId])
  @@unique([timelineId, position])
  @@map("timeline_events")
}

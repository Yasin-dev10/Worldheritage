{
  "realm": "worldheritage",
  "enabled": true,
  "displayName": "WorldHeritage Local",
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "Admin" },
      { "name": "Editor" },
      { "name": "Reviewer" }
    ]
  },
  "clients": [
    {
      "clientId": "worldheritage-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3001/admin/login"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "WorldHeritage API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "worldheritage-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "Top-level application roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "local-admin",
      "email": "local-admin@worldheritage.test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${WH_LOCAL_ADMIN_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": ["Admin"]
    }
  ]
}

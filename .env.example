# Placeholder inventory only. Replace with values from a local secret generator or secret manager.
# Never put real credentials here or commit a populated .env file.
NODE_ENV=development
API_PORT=4001
WEB_ORIGIN=http://localhost:3001
API_BASE_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_MEDIA_ORIGINS=https://assets.example.org
SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/worldheritage
POSTGRES_DB=worldheritage
POSTGRES_PORT=5432
POSTGRES_USER=<set-locally>
POSTGRES_PASSWORD=<set-a-local-development-password>
AUTH_ISSUER_URL=http://localhost:8080/realms/worldheritage
AUTH_CLIENT_ID=worldheritage-web
AUTH_CLIENT_SECRET=<set-locally>
AUTH_AUDIENCE=worldheritage-api
SESSION_SECRET=<generate-a-long-random-value>
NEXT_PUBLIC_AUTH_ISSUER_URL=http://localhost:8080/realms/worldheritage
NEXT_PUBLIC_AUTH_CLIENT_ID=worldheritage-web
NEXT_PUBLIC_AUTH_AUDIENCE=worldheritage-api
KEYCLOAK_PORT=8080
KC_BOOTSTRAP_ADMIN_USERNAME=local-kc-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<generate-a-local-password>
WH_LOCAL_ADMIN_PASSWORD=<generate-a-local-password>
LOG_LEVEL=info
